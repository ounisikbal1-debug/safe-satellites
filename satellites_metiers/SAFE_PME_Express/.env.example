# ─────────────────────────────────────────────────────────────────────────────
# ERP Tunisie — configuration d'exemple
# Copiez ce fichier en « .env » puis adaptez les valeurs.
#   cp .env.example .env
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (obligatoire) ────────────────────────────────────────────
# PostgreSQL 14 ou supérieur.
DATABASE_URL=postgresql://erp:motdepasse_fort@localhost:5432/erp_tunisie

# Pilote de connexion : « tcp » (node-postgres, recommandé pour un serveur
# résident) ou « http » (Neon serverless, uniquement pour un DSN Neon).
DB_DRIVER=tcp

# Nombre maximal de connexions du pool. 5 convient à une PME.
DB_POOL_MAX=5

# ── Sécurité (obligatoire) ───────────────────────────────────────────────────
# Secret de signature des sessions. Générez-en un avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changez_moi_par_une_chaine_aleatoire_de_64_caracteres

# Mode d'authentification : « local » (e-mail + mot de passe) ou « none »
# (accès libre, sans connexion — déconseillé en production).
AUTH_PROVIDER=local

# ── Réseau ───────────────────────────────────────────────────────────────────
# Port d'écoute. En production, l'ERP écoute sur ce port.
PORT=3000

# Port de l'API en développement (Vite proxifie /trpc vers ce port).
API_PORT=3001

# ── Transmissions fiscales (optionnel) ───────────────────────────────────────
# Sans ces clés, l'ERP refuse l'envoi vers la Télédéclaration et e-Fatoura
# et l'indique dans le journal des transmissions. Aucune transmission n'est
# simulée.
# TTN_API_URL=https://api.teledeclaration.tn
# TTN_API_KEY=
# EFATOURA_API_URL=https://api.e-fatoura.tn
# EFATOURA_API_KEY=
